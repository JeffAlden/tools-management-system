NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=altech_tms
MYSQL_USER=tms_app
MYSQL_PASSWORD=
# Managed MySQL: absolute path to provider CA certificate. Empty only for local MySQL.
MYSQL_SSL_CA=
UPLOAD_DIR=./uploads
# Set to 1 only behind the supplied trusted reverse proxy.
TRUST_PROXY=0
# Setup reads these once; remove them after creating the initial account.
SETUP_USERNAME=
SETUP_NAME=
SETUP_PASSWORD=
